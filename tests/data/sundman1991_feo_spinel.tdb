$ Magnetite (spinel) of the Fe-O description of Sundman, J. Phase Equilib. 12 (1991) 127,
$ Table 1 (pp. 128-129), https://doi.org/10.1007/BF02645709, with the O2 gas of the same
$ table to set the oxygen potential. Four sublattices, sites 1:2:2:4,
$ (Fe+2,Fe+3)(Fe+2,Fe+3,Va)(Fe+2,Va)(O-2). The functions G, B, C and D are those of the
$ table. Kjellqvist et al. (2008), and pycalphad's alfeo.tdb after them, differ from it in
$ one end member: Fe+2:Fe+2:Va:O-2 is 7G - B here and 7G + B there. The table gives
$ p = 0.28 but not the antiferromagnetic factor; TC is positive, so it is not used.
ELEMENT /- ELECTRON_GAS 0 0 0 !
ELEMENT VA VACUUM 0 0 0 !
ELEMENT FE BCC_A2 55.847 4489 27.28 !
ELEMENT O 1/2_MOLE_O2(GAS) 15.999 4341 102.52 !
SPECIES FE+2 FE1/+2 !
SPECIES FE+3 FE1/+3 !
SPECIES O-2 O1/-2 !
SPECIES O2 O2 !

FUNCTION GFE3O4 298.15 -161731+144.873*T-24.9879*T*LN(T)-0.0011952256*T**2+206520*T**(-1); 6000 N !
FUNCTION BFE3O4 298.15 46826-27.266*T; 6000 N !
FUNCTION CFE3O4 298.15 120730-20.102*T; 6000 N !
FUNCTION DFE3O4 298.15 402520-30.529*T; 6000 N !
FUNCTION GO2GAS 298.15 -6961.74451-76729.7484*T**(-1)-51.0057202*T-22.2710136*T*LN(T)
  -0.0101977469*T**2+1.32369208E-06*T**3; 1000 Y
  -13137.5203+525809.556*T**(-1)+25.3200332*T-33.627603*T*LN(T)-0.00119159274*T**2
  +1.35611111E-08*T**3; 3300 Y
  -27973.4908+8766421.4*T**(-1)+62.5195726*T-37.9072074*T*LN(T)-8.50483772E-04*T**2
  +2.14409777E-08*T**3; 6000 N !

TYPE_DEFINITION % SEQ * !
TYPE_DEFINITION * GES A_P_D SPINEL MAGNETIC -3.0 0.28 !

PHASE GAS:G % 1 1 !
CONSTITUENT GAS:G :O2: !
PARAMETER G(GAS,O2;0) 298.15 +GO2GAS+R*T*LN(1E-05*P); 6000 N !

PHASE SPINEL %* 4 1 2 2 4 !
CONSTITUENT SPINEL :FE+2,FE+3:FE+2,FE+3,VA:FE+2,VA:O-2: !
PARAMETER G(SPINEL,FE+2:FE+2:FE+2:O-2;0) 298.15 +9*GFE3O4+DFE3O4; 6000 N !
PARAMETER G(SPINEL,FE+3:FE+2:FE+2:O-2;0) 298.15 +9*GFE3O4+DFE3O4-BFE3O4; 6000 N !
PARAMETER G(SPINEL,FE+2:FE+3:FE+2:O-2;0) 298.15 +9*GFE3O4+DFE3O4-BFE3O4; 6000 N !
PARAMETER G(SPINEL,FE+3:FE+3:FE+2:O-2;0) 298.15 +9*GFE3O4+DFE3O4-2*BFE3O4; 6000 N !
PARAMETER G(SPINEL,FE+2:VA:FE+2:O-2;0) 298.15 +7*GFE3O4+DFE3O4-BFE3O4+CFE3O4; 6000 N !
PARAMETER G(SPINEL,FE+3:VA:FE+2:O-2;0) 298.15 +7*GFE3O4+DFE3O4-2*BFE3O4+CFE3O4; 6000 N !
PARAMETER G(SPINEL,FE+2:FE+2:VA:O-2;0) 298.15 +7*GFE3O4-BFE3O4; 6000 N !
PARAMETER G(SPINEL,FE+3:FE+2:VA:O-2;0) 298.15 +7*GFE3O4; 6000 N !
PARAMETER G(SPINEL,FE+2:FE+3:VA:O-2;0) 298.15 +7*GFE3O4; 6000 N !
PARAMETER G(SPINEL,FE+3:FE+3:VA:O-2;0) 298.15 +7*GFE3O4-BFE3O4; 6000 N !
PARAMETER G(SPINEL,FE+2:VA:VA:O-2;0) 298.15 +5*GFE3O4+CFE3O4; 6000 N !
PARAMETER G(SPINEL,FE+3:VA:VA:O-2;0) 298.15 +5*GFE3O4-BFE3O4+CFE3O4; 6000 N !
PARAMETER TC(SPINEL,FE+2:FE+2:FE+2:O-2;0) 298.15 848; 6000 N !
PARAMETER BMAGN(SPINEL,FE+2:FE+2:FE+2:O-2;0) 298.15 44.54; 6000 N !
PARAMETER TC(SPINEL,FE+2:FE+2:VA:O-2;0) 298.15 848; 6000 N !
PARAMETER BMAGN(SPINEL,FE+2:FE+2:VA:O-2;0) 298.15 44.54; 6000 N !
PARAMETER TC(SPINEL,FE+2:FE+3:FE+2:O-2;0) 298.15 848; 6000 N !
PARAMETER BMAGN(SPINEL,FE+2:FE+3:FE+2:O-2;0) 298.15 44.54; 6000 N !
PARAMETER TC(SPINEL,FE+2:FE+3:VA:O-2;0) 298.15 848; 6000 N !
PARAMETER BMAGN(SPINEL,FE+2:FE+3:VA:O-2;0) 298.15 44.54; 6000 N !
PARAMETER TC(SPINEL,FE+2:VA:FE+2:O-2;0) 298.15 848; 6000 N !
PARAMETER BMAGN(SPINEL,FE+2:VA:FE+2:O-2;0) 298.15 44.54; 6000 N !
PARAMETER TC(SPINEL,FE+2:VA:VA:O-2;0) 298.15 848; 6000 N !
PARAMETER BMAGN(SPINEL,FE+2:VA:VA:O-2;0) 298.15 44.54; 6000 N !
PARAMETER TC(SPINEL,FE+3:FE+2:FE+2:O-2;0) 298.15 848; 6000 N !
PARAMETER BMAGN(SPINEL,FE+3:FE+2:FE+2:O-2;0) 298.15 44.54; 6000 N !
PARAMETER TC(SPINEL,FE+3:FE+2:VA:O-2;0) 298.15 848; 6000 N !
PARAMETER BMAGN(SPINEL,FE+3:FE+2:VA:O-2;0) 298.15 44.54; 6000 N !
PARAMETER TC(SPINEL,FE+3:FE+3:FE+2:O-2;0) 298.15 848; 6000 N !
PARAMETER BMAGN(SPINEL,FE+3:FE+3:FE+2:O-2;0) 298.15 44.54; 6000 N !
PARAMETER TC(SPINEL,FE+3:FE+3:VA:O-2;0) 298.15 848; 6000 N !
PARAMETER BMAGN(SPINEL,FE+3:FE+3:VA:O-2;0) 298.15 44.54; 6000 N !
PARAMETER TC(SPINEL,FE+3:VA:FE+2:O-2;0) 298.15 848; 6000 N !
PARAMETER BMAGN(SPINEL,FE+3:VA:FE+2:O-2;0) 298.15 44.54; 6000 N !
PARAMETER TC(SPINEL,FE+3:VA:VA:O-2;0) 298.15 848; 6000 N !
PARAMETER BMAGN(SPINEL,FE+3:VA:VA:O-2;0) 298.15 44.54; 6000 N !
